{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "conversations.update",
  "description": "Update mutable fields on a conversation (currently title). Owner or admin only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "conversation_id": {
        "type": "string",
        "description": "Conversation ID to update (required)"
      },
      "title": {
        "type": ["string", "null"],
        "maxLength": 500,
        "description": "New title, or null to clear"
      },
      "user_id": {
        "type": "string",
        "description": "ID of the user performing the update"
      },
      "org_id": {
        "type": "string",
        "description": "Optional organization ID for multi-tenant context"
      }
    },
    "required": ["conversation_id"]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "success": { "type": "boolean" },
      "conversation": { "type": "object" },
      "error": { "type": "string" }
    }
  }
}
